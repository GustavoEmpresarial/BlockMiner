# Vite client — copy to client/.env for local dev (npm run dev in current/client/)
# Backend the dev proxy (see vite.config.ts) forwards /api and /socket.io to.
# Defaults to http://localhost:3000, matching current/.env PORT.
VITE_BACKEND_PROXY_TARGET=http://localhost:3000

# HTTP API request timeout (ms). Floors at 60000 regardless of value set here (see apiTimeout.ts).
# VITE_API_TIMEOUT_MS=60000

# Cloudflare Turnstile site keys (public). Leave unset in dev — current/server's
# requireTurnstileWhenConfigured() is a no-op while TURNSTILE_SECRET_KEY is unset,
# so the UI hides the widget entirely (same behavior as legacy/client).
# For the prebuilt SPA, site keys are also injected at runtime via
# window.__BLOCKMINER_ENV__ / __BM_TURNSTILE_SITE_KEY__ in client/dist/index.html.
# VITE_TURNSTILE_SITE_KEY=
# VITE_TURNSTILE_SITE_KEY_LOGIN=
# VITE_TURNSTILE_SITE_KEY_REGISTER=
