# current/ — modelo único de env, cobre dev E produção (copie pra .env local, ou pra
# .env.production no servidor via docker-compose.yml). Só 2 arquivos de env existem
# neste projeto: .env (real, gitignored) e este .env.example (template, versionado).
#
# Toda variável abaixo foi levantada por grep real em server/ (process.env.X) — nada
# aqui é chute. A maioria tem um default seguro no próprio código (comentada = "usa o
# default do código"); descomente só o que precisar mudar. As marcadas [OBRIGATÓRIO]
# não têm default e o processo recusa subir sem elas.
#
# server/core/database/prisma.ts recusa subir se DATABASE_URL contiver um identificador
# conhecido de produção (IP da VPS, blockminer.space) quando NODE_ENV≠production — não
# remova essa checagem.

# ============================================================================
# CORE [OBRIGATÓRIO]
# ============================================================================
NODE_ENV=development
PORT=3000

# Postgres/Redis locais: `DB_PASSWORD=blockminer_dev_password docker compose up -d db redis`
# (mesmo docker-compose.yml usado pra deploy real — um único arquivo, sem .dev separado).
DB_PASSWORD=blockminer_dev_password
DATABASE_URL=postgresql://blockminer:blockminer_dev_password@localhost:5432/blockminer?schema=public
REDIS_URL=redis://127.0.0.1:6379

JWT_SECRET=dev-only-change-me
JWT_REFRESH_SECRET=dev-only-change-me-too
COOKIE_SECRET=dev-only-change-me-as-well

# [OBRIGATÓRIO em produção — setupHttpStack.ts falha no boot se NODE_ENV=production e
# isso estiver vazio] Origens reais separadas por vírgula.
# CORS_ORIGINS=https://seu-dominio.exemplo,https://www.seu-dominio.exemplo
# Parceiros (genesisdao.tech, minercore.online, etc.) também entram via BUILTIN em server/shared/http/corsConfig.ts
# Para login em iframe no parceiro, use AUTH_COOKIE_SAMESITE=none e CSRF_COOKIE_SAMESITE=none

# ============================================================================
# HTTP / segurança de transporte
# ============================================================================
# TRUST_PROXY=1                    # nº de hops de proxy confiáveis (Express trust proxy)
# FORCE_HTTPS=1                    # redirect HTTP→HTTPS + HSTS (só age se NODE_ENV=production)
# HSTS_MAX_AGE_SECONDS=31536000
# HSTS_INCLUDE_SUBDOMAINS=1
# HSTS_PRELOAD=0
# COOKIE_DOMAIN=
# AUTH_COOKIE_SAMESITE=lax
# CSRF_COOKIE_SAMESITE=lax
# ADMIN_SESSION_COOKIE_DOMAIN=
# ADMIN_SESSION_COOKIE_SECURE=1
# TRUSTED_PROXY_CIDRS=

# ============================================================================
# Auth / sessão / admin
# ============================================================================
# ACCESS_TOKEN_TTL=15m
# ACCESS_TOKEN_RENEW_THRESHOLD_MS=120000
# REFRESH_TOKEN_TTL_DAYS=30
# JWT_ISSUER=blockminer
# JWT_AUDIENCE=blockminer-app
# AUTH_USER_CACHE_TTL_MS=8000
# ADMIN_AUTH_CACHE_TTL_MS=8000
# ADMIN_JWT_EXPIRES_IN=8h
# PASSWORD_RESET_TOKEN_TTL=1h
# AUTH_DEBUG_LOG=0
# AUTH_DEBUG_LOG=1  # log completo de auth; tentativas de login em iframe/parceiro (genesisdao) logam sempre
# AUTH_EMAIL_2FA_ENABLED=0
# AUTH_EMAIL_2FA_REQUIRED_FOR_ADMINS=0
# AUTH_EMAIL_2FA_REQUIRED_FOR_ALL_USERS=0
# SatsPay OAuth ("Entrar com SatsPay") — crie o app no painel SatsPay e registre:
#   https://blockminer.space/api/auth/satspay/callback
#   https://www.blockminer.space/api/auth/satspay/callback
#   https://dev.blockminer.space/api/auth/satspay/callback
# SATSPAY_OAUTH_ENABLED=1
# SATSPAY_CLIENT_ID=sats_app_...
# SATSPAY_CLIENT_SECRET=sats_sec_...
# SATSPAY_API_BASE=https://www.satspay.pro
# SATSPAY_BUTTON_THEME=light
# SATSPAY_HTTP_TIMEOUT_MS=15000
# Google OAuth ("Entrar com Google") — Google Cloud Console OAuth client; redirect URIs:
#   https://blockminer.space/api/auth/google/callback
#   https://www.blockminer.space/api/auth/google/callback
#   https://dev.blockminer.space/api/auth/google/callback
# GOOGLE_OAUTH_ENABLED=1
# GOOGLE_CLIENT_ID=....apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# GOOGLE_REDIRECT_URIS=
# GOOGLE_HTTP_TIMEOUT_MS=15000
# ADMIN_BOOTSTRAP_ENABLED=0        # cria admin inicial no boot — só em dev/setup
# ADMIN_EMAIL=
# ADMIN_SECURITY_CODE=
# ADMIN_KEYED_PASSWORD_RESET_ENABLED=0
# ADMIN_FRAUD_COLLECTION_RESET_CONFIRM=   # frase exata exigida por POST fraud-signals/reset-collection

# ============================================================================
# Postgres (pool) / Prisma
# ============================================================================
# PG_POOL_MAX=20
# PG_POOL_IDLE_MS=30000
# PG_POOL_CONNECTION_TIMEOUT_MS=10000
# PG_STATEMENT_TIMEOUT_MS=30000
# PG_IDLE_IN_TX_TIMEOUT_MS=30000
# PRISMA_TX_MAX_WAIT_MS=10000
# PRISMA_TX_TIMEOUT_MS=15000

# ============================================================================
# Redis (client)
# ============================================================================
# REDIS_CONNECT_TIMEOUT_MS=5000
# REDIS_COMMAND_TIMEOUT_MS=3000

# ============================================================================
# Blockchain — depósito on-chain (read-only, NUNCA assina — ver docs/PROGRESSO.txt
# item 10b sobre a exclusão deliberada do HD sweep)
# ============================================================================
# POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
# POLYGON_RPC_TIMEOUT_MS=4500
# ETHEREUM_RPC_URL=
# BSC_RPC_URL=
# DEPOSIT_WALLET_ADDRESS=
# SMART_CONTRACT_ADDRESS=
# DEPOSIT_MIN_CONFIRMATIONS=50
# DEPOSIT_MIN_AMOUNT=0.01
# MIN_DEPOSIT_POL=1
# DEPOSIT_VERIFIER_CRON_MS=15000
# POLYGONSCAN_API_KEY=
# POLYGONSCAN_BASE_URL=https://api.polygonscan.com
# WALLET_SNAPSHOT_CRON_MS=600000

# ============================================================================
# Depósito HD custodial — endereço Polygon único por usuário (docs/PROGRESSO.txt item
# 67). POLYGON_HD_MNEMONIC controla fundos reais e só existe no serviço isolado `phd`
# (docker-compose.yml) — NUNCA no processo `app`. Consolidar (sweep) pra tesouraria é
# DESATIVADO por padrão de propósito, mesma lógica do saque automático abaixo.
# ============================================================================
# POLYGON_HD_DEPOSIT_ENABLED=0
# PHD_SERVICE_URL=http://phd:3847
# PHD_INTERNAL_TOKEN=
# PHD_PORT=3847
# POLYGON_HD_MNEMONIC=
# POLYGON_HD_SWEEP_TO_ADDRESS=
# POLYGON_HD_AUTO_SWEEP=0
# POLYGON_HD_SWEEP_CRON_MS=300000
# POLYGON_HD_DEPOSIT_SCAN_INTERVAL_MS=900000
# POLYGON_HD_SCAN_LOOKBACK_BLOCKS=250000
# POLYGON_HD_AUTO_SCAN=1
# POLYGON_HD_MIN_DEPOSIT_POL=1

# ============================================================================
# Saque automático — DESATIVADO por padrão de propósito (ver docs/PROGRESSO.txt,
# item sobre segurança financeira: motor pronto, validado só em dry-run). Só preencha
# se você entende o risco real: mover fundos de uma carteira quente automaticamente.
# ============================================================================
# WITHDRAWAL_AUTO_SEND=false
# WITHDRAWAL_AUTO_SEND_GLOBAL_PAUSE=false
# WITHDRAWAL_AUTO_SEND_CRON_MS=15000
# WITHDRAWAL_AUTO_SEND_MAX_PER_DAY_PER_USER=3
# SHIB ERC20 withdraw (off by default — set to 1 only when intentionally enabled)
# SHIB_WITHDRAWALS_ENABLED=0
# SHIB_WITHDRAW_FEE=7800
# WITHDRAW_MIN_SHIB_USD=0.1
# WITHDRAWAL_PRIVATE_KEY=
# WITHDRAWAL_HOT_WALLET_MIN_BALANCE_POL=
# WITHDRAWAL_HOT_WALLET_RETRY_COOLDOWN_SEC=1800
# WITHDRAWAL_VIA_COINEX=false
# WITHDRAWAL_COINEX_POLL_CRON_MS=60000
# COINEX_ACCESS_ID=
# COINEX_SECRET=

# ============================================================================
# Telegram (worker de outbox real, ver docs/PROGRESSO.txt item 10c — sem token real,
# degrada honestamente: grava no outbox, nunca finge que enviou)
# ============================================================================
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_PRIVATE_WITHDRAWAL_ALERT_CHAT_ID=
# TELEGRAM_PUBLIC_PROOF_CHAT_ID=
# TELEGRAM_PUBLIC_PROOF_THREAD_ID=
# TELEGRAM_WORKER_POLL_INTERVAL_MS=1000
# TELEGRAM_WORKER_BATCH_SIZE=10
# TELEGRAM_WORKER_MAX_ATTEMPTS=5

# ============================================================================
# IP intelligence / antibot / ProxyCheck.io (degrada honestamente sem chave — ver
# docs/PROGRESSO.txt item 13f)
# ============================================================================
# IP_HEADER_PRIORITY=cf-connecting-ip,x-real-ip,x-forwarded-for
# IP_INFRASTRUCTURE_CIDRS=
# IP_ASN_PROVIDER=
# IPINFO_TOKEN=
# IP_INTEL_ASN_TIMEOUT_MS=4000
# IP_INTEL_DNS_TIMEOUT_MS=3000
# IP_INTEL_CACHE_TTL_HOURS=24
# IP_INTEL_SUCCESS_TTL_DAYS=14
# IP_INTEL_ERROR_TTL_HOURS=1
# IP_INTEL_REVERSE_DNS_ENABLED=0
# PROXYCHECK_API_KEY=
# PROXYCHECK_ENABLED=false
# PROXYCHECK_TTL_HOURS=24
# PROXYCHECK_DAILY_LIMIT=1000
# PROXYCHECK_TIMEOUT_MS=4000
# VPNAPI.io — https://vpnapi.io/api/{ip}?key=  (free tier: 1000/day UTC)
# VPNAPI_API_KEY=
# VPNAPI_ENABLED=false
# VPNAPI_BASE_URL=https://vpnapi.io/api
# VPNAPI_TTL_HOURS=24
# VPNAPI_DAILY_LIMIT=1000
# VPNAPI_TIMEOUT_MS=4000
# AUTH_BLOCK_VPN_PROXY=true
# Consensus: when 2+ providers answer, require this many positive hits (Tor always wins).
# IP_INTEL_PROXY_MIN_HITS=2
# GetIPIntel — free ≤500/day; contact email required (flags=m → 0|1)
# GETIPINTEL_ENABLED=false
# GETIPINTEL_CONTACT_EMAIL=
# GETIPINTEL_FLAGS=m
# GETIPINTEL_BLOCK_SCORE=1
# GETIPINTEL_TTL_HOURS=24
# GETIPINTEL_DAILY_LIMIT=500
# GETIPINTEL_TIMEOUT_MS=4000
# IPLogs — free, no key; often noisy — keep off unless needed
# IPLOGS_ENABLED=false
# IPLOGS_BASE_URL=https://iplogs.com
# IPLOGS_TTL_HOURS=24
# IPLOGS_DAILY_LIMIT=2000
# IPLOGS_TIMEOUT_MS=4000
# ipapi.is — free 1000/day with key (is_vpn/is_proxy/is_tor)
# IPAPIIS_ENABLED=false
# IPAPIIS_API_KEY=
# IPAPIIS_BASE_URL=https://api.ipapi.is
# IPAPIIS_TTL_HOURS=24
# IPAPIIS_DAILY_LIMIT=1000
# IPAPIIS_TIMEOUT_MS=4000
# IPHub — free 1000/day (X-Key); block 1|2 = proxy/VPN/hosting
# IPHUB_ENABLED=false
# IPHUB_API_KEY=
# IPHUB_BASE_URL=https://v2.api.iphub.info
# IPHUB_TTL_HOURS=24
# IPHUB_DAILY_LIMIT=1000
# IPHUB_TIMEOUT_MS=4000
# IPQualityScore — free 1000/month (soft daily = floor(1000/31))
# IPQS_ENABLED=false
# IPQS_API_KEY=
# IPQS_BASE_URL=https://ipqualityscore.com/api/json/ip
# IPQS_STRICTNESS=1
# IPQS_TTL_HOURS=24
# IPQS_DAILY_LIMIT=32
# IPQS_TIMEOUT_MS=4000
# VPN Blocker — free ~500/month; host-ip alone is hosting (not VPN). Keep off unless needed.
# VPNBLOCKER_ENABLED=false
# VPNBLOCKER_API_KEY=
# VPNBLOCKER_BASE_URL=https://api.vpnblocker.net/v2
# VPNBLOCKER_TTL_HOURS=24
# VPNBLOCKER_DAILY_LIMIT=16
# VPNBLOCKER_TIMEOUT_MS=4000
# AbstractAPI IP Intelligence — free 1000/month
# ABSTRACTAPI_ENABLED=false
# ABSTRACTAPI_API_KEY=
# ABSTRACTAPI_BASE_URL=https://ip-intelligence.abstractapi.com/v1
# ABSTRACTAPI_TTL_HOURS=24
# ABSTRACTAPI_DAILY_LIMIT=32
# ABSTRACTAPI_TIMEOUT_MS=4000
# ANTIBOT_GAMES_ONLY=1
# Comma prefixes when set (overrides games-only). Example: game,site:integrity
# ANTIBOT_EVENT_ALLOWLIST=
# ANTIBOT_SHARED_IP_ACCOUNTS=8
# ANTIBOT_SHARED_FP_ACCOUNTS=4
# ANTIBOT_SHARED_WALLET_ACCOUNTS=2
# Mini-game reward antibot gate (finishGame + 2048 claim)
# GAME_ANTIBOT_GATE_ENABLED=true
# GAME_ANTIBOT_DENY_MIN_SCORE=61
# Deny suspicious band (41–60). Default false — high/critical only unless explicitly enabled.
# GAME_ANTIBOT_DENY_SUSPICIOUS=false
# GAME_ANTIBOT_BLOCK_COOLDOWN_SEC=60
# GAME_ANTIBOT_AUTOMATION_COOLDOWN_SEC=120
# GAME_BURST_REJECT_COOLDOWN_SEC=90
# HOST_IP=
# SERVER_IP=
# SERVER_PUBLIC_IP=
# ZERADS_SERVER_IP=

# ============================================================================
# Mídia / uploads / backups
# ============================================================================
# UPLOADS_DIR=                     # default: current/storage/uploads
# MEDIA_PUBLIC_PREFIX=/media
# MEDIA_WEBP_QUALITY=82
# BACKUP_DIR=                      # default: current/storage/backups
# BACKUP_SKIP_ROW_COUNT_AUDIT=0
# PG_DUMP_PATH=pg_dump

# ============================================================================
# Crons de manutenção — intervalos, todos têm default sensato no código
# ============================================================================
# CHECKIN_MODE=offchain            # offchain = só saldo interno | onchain | hybrid
# CHECKIN_PENDING_CRON_MS=300000
# ENERGY_TAX_SWEEP_CRON_MS=
# AUTO_MINING_SESSION_CLEANUP_CRON_MS=300000
# EXPIRED_POWERS_CLEANUP_CRON_MS=300000
# OFFER_EVENTS_EXPIRE_CRON_MS=
# NOTIFICATIONS_RETENTION_CRON_MS=
# NOTIFICATIONS_RETENTION_DAYS=30
# NOTIFICATIONS_RETENTION_BATCH=5000
# NOTIFICATIONS_RETENTION_BATCHES_PER_TICK=10
# SECURITY_ARTIFACT_CLEANUP_MS=
# SECURITY_ARTIFACT_MAX_AGE_H=72
# USER_COUNT_SNAPSHOT_MS=
# MINING_TICK_MS=
# MINING_BLOCK_INTERVAL_MS=

# ============================================================================
# Mineração / engajamento / jogos
# ============================================================================
# GAME2048_COOLDOWN_MS=
# GAME2048_MIN_SCORE=
# GAME2048_POWER_DAYS=
# GAME2048_POWER_HOURS_NO_CHECKIN=
# GAME2048_REWARD_HASHRATE=
# GAME2048_TIME_LIMIT_SEC=
# GAME2048_WIN_TILE=
# GAME_POWER_DAYS=
# MEMORY_MISMATCH_REVEAL_MS=
# HEARTBEAT_MIN_INTERVAL_MS=
# HEARTBEAT_MAX_CREDIT_SECONDS=
# HEARTBEAT_MAX_CREDIT_SECONDS_BOOSTED=
# HEARTBEAT_FINGERPRINT_MAX_AGE_MS=
# HEARTBEAT_FINGERPRINT_FUTURE_SKEW_MS=
# PRESENCE_BALANCE_CAP=
# YOUTUBE_REWARD_DURATION_HOURS=
# YT_POWER_DAYS=
# SHOP_MAX_BULK_QUANTITY=
# AUTO_MINING_V2_FALLBACK_URL=

# ============================================================================
# Rooms / racks
# ============================================================================
# ROOM_MAX=
# ROOM_PRICES=0,10,50,75  # BLK per room (room 1 free)
# ROOM_OFFER_PRICES=0,5,25,37.5  # 50% off paid rooms
# ROOM_OFFER_IMAGE_URLS=/media/sala/room-1.webp,/media/sala/room-2.webp,/media/sala/room-3.webp,/media/sala/room-4.webp
# RACKS_PER_ROOM=

# ============================================================================
# Ads / offerwalls (cada um com seu próprio segredo de callback — nunca compartilhar)
# ============================================================================
# MONEYRAIN_CALLBACK_SECRET=
# MONEYRAIN_MAINTENANCE=0
# MONEYRAIN_MAX_PAYOUT_USD=
# MONEYRAIN_PUBLISHER_ID=
# MONEYRAIN_SITE_KEY=
# MONEYRAIN_SITE_SECRETS_JSON=
# OFFERWALLME_SECRET=
# OFFERWALLME_API_KEY=
# OFFERWALLME_ALLOWED_IPS=
# OFFERWALLME_MAX_PAYOUT_USD=
# ZERADS_CALLBACK_SECRET=
# ZERADS_CALLBACK_PASSWORD=
# ZERADS_ALLOWED_IPS=
# ZERADS_EXCHANGE_RATE=
# ZERADS_PTC_EXCHANGE_RATE=
# ZERADS_MAX_ZER_PER_CALLBACK=
# ZERADS_MAX_CLICKS_PER_UTC_DAY=
# ZERADS_MAX_CLICKS_PER_BRT_DAY=
# ZERADS_MAX_CLICKS_PER_CALLBACK=10
# ZERADS_VELOCITY_WINDOW_MS=3600000
# ZERADS_MAX_CLICKS_PER_VELOCITY_WINDOW=30
# ZERADS_ANTIBOT_GATE_ENABLED=1
# ZERADS_ANTIBOT_DENY_MIN_SCORE=61
# ZERADS_ANTIBOT_DENY_SUSPICIOUS=0
# BM_CAPTCHA_ENABLED=1
# Temporarily off in prod: BM_CAPTCHA_ENABLED=0
# BM_CAPTCHA_HMAC_SECRET=
# BM_CAPTCHA_CHALLENGE_TTL_MS=180000
# BM_CAPTCHA_PASS_TTL_MS=120000
# BM_CAPTCHA_MIN_SOLVE_MS=1200
# BM_CAPTCHA_MAX_ATTEMPTS=5
# BM_CAPTCHA_DIAL_TOLERANCE_DEG=12
# BM_CAPTCHA_POW_DIFFICULTY=3
# BM_CAPTCHA_TILE_COUNT=6
# OFFERWALLME_PUBLISHER_ID=
# Offerwall PRO (UI: Multiwall) — API/SECRET from publisher dashboard
# Multiwall Ads PTC (multiwall-ads.shop) — Webmaster "PTC Module"
# Embed: https://multiwall-ads.shop/api.php?page=main&api={API_KEY}&id={USER_ID}
# Postback hash: md5(secret + user_id + transaction + amount + amountus)
# MULTIWALL_API_KEY=
# MULTIWALL_SECRET=
# MULTIWALL_ALLOWED_IPS=148.72.132.180
# MULTIWALL_OFFERWALL_BASE_URL=https://multiwall-ads.shop/api.php
# MULTIWALL_MAX_PAYOUT_USD=50
# Offerwall.GG — public key in wall URL; secret for HMAC postbacks only
# OFFERWALLGG_PUBLIC_KEY=
# OFFERWALLGG_SECRET=
# OFFERWALLGG_ALLOWED_IPS=
# OFFERWALLGG_WALL_BASE_URL=https://offerwall.gg/wall
# OFFERWALLGG_MAX_PAYOUT_USD=50
# INTERNAL_OFFERWALL_ENABLED=1
# INTERNAL_OFFERWALL_REWARD_BLK=0.0005
# INTERNAL_OFFERWALL_WEBHOOK_URL=
# INTERNAL_OFFERWALL_WEBHOOK_SECRET=
# INTERNAL_OFFERWALL_ALLOW_HTTP_IFRAME=0
# INTERNAL_OFFERWALL_ABANDON_STARTED_AFTER_SEC=

# ============================================================================
# Torneios
# ============================================================================
# TOURNAMENT_ENGINE_V2=1            # obrigatório pra Zerads/offerwall/minigame contarem no ranking em tempo real
# TOURNAMENT_OFFERWALL_AUTOCORRECT=1 # reconcilia ranking a partir de ZeradsCallback / offerwall.me / internal
# TOURNAMENT_REALTIME_FLUSH_MS=800
# TOURNAMENT_SKIP_GET_RECOMPUTE=0
# DRIFT_RETENTION_DAYS=30

# ============================================================================
# Diversos
# ============================================================================
# SITE_LAUNCH_DATE=2026-03-05T00:00:00.000Z
# APP_URL=https://seu-dominio.exemplo
# VITE_PUBLIC_WALLET_APP_URL=
# SUPPORT_ADMIN_PUBLIC_URL=
# LOG_LEVEL=info
# TZ=UTC
# SITE_MAINTENANCE=0
# Comma-separated hosts that stay open while SITE_MAINTENANCE=1 (e.g. staging).
# SITE_MAINTENANCE_BYPASS_HOSTS=dev.blockminer.space
# TURNSTILE_SECRET_KEY=
# Mini-games: require Cloudflare Turnstile every N rewarded plays (0=off). Default 10.
# GAME_TURNSTILE_EVERY_N=10
# Temporarily off in prod: GAME_TURNSTILE_EVERY_N=0
# YouTube / faucet / shortlink page-entry Turnstile (1=on when secret set). Default on.
# FEATURE_TURNSTILE_ENABLED=1
# Temporarily off in prod: FEATURE_TURNSTILE_ENABLED=0
# Tampermonkey/Violentmonkey session kick (1=on). Default off in code; set 1 to re-enable.
# USERSCRIPT_MANAGER_KICK_ENABLED=0
# USER_ACTIVITY_LOG_READS=0
# ENERGY_TAX_STARTS_AT_ISO=
# SMTP_HOST=
# SMTP_FROM=

# ZerAds Shortlink API (linkapi.php) — user from publisher panel (e.g. ElonMuskBRr)
# ZERADS_SHORTLINK_MAINTENANCE=0
# ZERADS_SHORTLINK_API_USER=ElonMuskBRr
# ZERADS_SHORTLINK_API_URL=https://zerads.com/linkapi.php
# ZERADS_SHORTLINK_STRICT=1
# ZERADS_SHORTLINK_ADSNUM=1
# ZERADS_SHORTLINK_FETCH_MS=12000
# ZERADS_SHORTLINK_FETCH_RETRIES=2
# PASTEAD_REWARD_HS=20
# PASTEAD_DAILY_HS_CAP=1000
# PASTEAD_MIN_ELAPSED_MS=15000
# PASTEAD_SESSION_TTL_MS=1800000

# AdLinkFly Shortlink API — same reward/cap as PASTEAD_*; maintenance ON by default
# ADLINKFLY_SHORTLINK_MAINTENANCE=1
# ADLINKFLY_SHORTLINK_API_TOKEN=
# ADLINKFLY_SHORTLINK_API_URL=http://169.58.45.155:8088/api
# ADLINKFLY_SHORTLINK_TYPE=1
# ADLINKFLY_SHORTLINK_FETCH_MS=12000
# ADLINKFLY_SHORTLINK_FETCH_RETRIES=2
