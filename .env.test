# Carregado ANTES do .env em toda rodada de `npm test` (ver script "test" em package.json).
# dotenv não sobrescreve variável já setada por padrão, então o que estiver aqui META por
# cima do que o .env real definir — só as chaves listadas abaixo, o resto continua vindo
# do .env normal (banco, redis, etc).
#
# Por quê: em 10/08/2026 a suíte de testes disparou uma mensagem REAL pelo bot REAL do
# Telegram (TELEGRAM_BOT_TOKEN real tinha acabado de entrar no .env — ver docs/PROGRESSO.txt,
# item "auditoria de segurança") — o worker de outbox faz um fetch de verdade pra
# api.telegram.org sempre que o token está presente, os testes de "token ausente" não
# esperavam isso. Mesma classe de risco pro mailer real (SMTP) — testes de forgot-password/
# 2FA por e-mail não devem mandar e-mail de verdade pra endereço nenhum.
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Não é risco de side-effect real (só afeta um boolean de verificação on-chain), mas
# alguns testes assumem explicitamente "sem env configurado" — mantém a suíte
# significativa em vez de testar um cenário que não existe mais.
CHECKIN_RECEIVER=
DEPOSIT_WALLET_ADDRESS=
